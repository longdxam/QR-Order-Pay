# ===== Server =====
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
SERVER_ORIGIN=http://localhost:4000
# Leave empty for host-only cookies (localhost and LAN demo).
COOKIE_DOMAIN=
COOKIE_SECURE=false
LOG_LEVEL=info

# MongoDB (replica set for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/maycafe?replicaSet=rs0&directConnection=true

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Demo seed
SEED_DEMO_PASSWORD=MayCafe@2025

# ===== Phiên bàn =====
# Khách quét QR tự mở phiên (false = quay lại hành vi 403 "bàn chưa mở phiên")
GUEST_AUTO_OPEN=true
# Tự đóng phiên tự mở không có đơn sau N phút (0 = tắt)
SESSION_IDLE_TIMEOUT_MIN=60

# ===== AI =====
# AI_MODE: live | fallback | off
AI_MODE=fallback
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# ===== Client (Vite) =====
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
