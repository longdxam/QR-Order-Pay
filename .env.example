# ===== Server =====
NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops. Keep 0 for direct local access; use 1 behind the bundled proxy.
TRUST_PROXY_HOPS=0
# Maximum time for active HTTP requests to finish during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
PUBLIC_APP_URL=http://localhost:5173
STAFF_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5173
SERVER_ORIGIN=http://localhost:4000
# Leave empty for host-only cookies (localhost and LAN demo).
COOKIE_DOMAIN=
COOKIE_SECURE=false
LOG_LEVEL=info
# Optional stable name in logs/metrics. If empty, the operating-system/container hostname is used.
INSTANCE_ID=

# MongoDB (replica set for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/maycafe?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_GUEST_MUTATION_MAX=60
RATE_LIMIT_MENU_SEARCH_MAX=120
RATE_LIMIT_AI_MAX=20

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Demo seed
SEED_DEMO_PASSWORD=MayCafe@2025

# ===== Phiên bàn =====
# Khách quét QR tự mở phiên (false = quay lại hành vi 403 "bàn chưa mở phiên")
GUEST_AUTO_OPEN=true
# Tự đóng phiên tự mở không có đơn sau N phút (0 = tắt)
SESSION_IDLE_TIMEOUT_MIN=60

# ===== AI =====
# AI_MODE: live | fallback | off
AI_MODE=fallback
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# Anomaly detector (P4B). Dùng aggregate có bằng chứng; AI chỉ giải thích cảnh báo mới.
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MS=60000
ANOMALY_WINDOW_MIN=15
ANOMALY_BASELINE_MIN=60
ANOMALY_MIN_SAMPLES=20
ANOMALY_ERROR_RATE=0.1
ANOMALY_LATENCY_P95_MS=1000
ANOMALY_PREPARATION_P95_SECONDS=900
ANOMALY_CANCELLATION_RATE=0.25
ANOMALY_BASELINE_MULTIPLIER=2
ANOMALY_COOLDOWN_MIN=30
ANOMALY_AI_MAX_PER_RUN=3

# ===== Client (Vite) =====
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
